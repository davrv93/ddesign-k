# Copia este archivo a .env y completa los valores (el .env NO se sube a git).
# Genera secretos con:  openssl rand -hex 24

# --- Negocio ---
BUSINESS_NAME="Baruka Design"
PUBLIC_URL=https://kddesign.pjgfactsalud.com.pe
# Número de WhatsApp de la tienda (sólo dígitos, con 51) para los botones del catálogo público
WHATSAPP_NUMBER=
CURRENCY=S/

# --- Acceso al panel ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET=
WEBHOOK_SECRET=

# --- evolution-go (WhatsApp) ---
EVOLUTION_DB_PASSWORD=
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE=kddesign
EVOLUTION_INSTANCE_TOKEN=

# --- IA (Google AI Studio, capa gratuita) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo en orden si el principal falla (cuota 429, 5xx, timeout)
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_TIMEOUT_SECONDS=40
# Confianza mínima (0-1) para dar por identificado el modelo de la foto
MATCH_THRESHOLD=0.6

# Carga el catálogo inicial (20 vestidos) la primera vez
SEED_CATALOG=true

# --- Puertos alternos en el host (sólo 127.0.0.1) ---
KD_HTTP_PORT=18480
KD_EVO_PORT=18481

# --- Agente conversacional (servicio agente) ---
# Clave de OpenRouter para DeepSeek. Sin ella el agente responde con las frases de referencia del dataset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1,deepseek/deepseek-v4-flash
# Modelo de embeddings local (fastembed). Alternativa ligera: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=jinaai/jina-embeddings-v2-base-es
KD_AGENT_PORT=18482
# Vacío desactiva el agente y el bot usa sólo Gemini
AGENT_URL=http://agente:8000
