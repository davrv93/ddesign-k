# Copia este archivo a .env y completa los valores (el .env NO se sube a git).
# Genera secretos con:  openssl rand -hex 24

# --- Negocio ---
BUSINESS_NAME="Baruka Design"
PUBLIC_URL=https://kddesign.pjgfactsalud.com.pe
# Número de WhatsApp de la tienda (sólo dígitos, con 51) para los botones del catálogo público
WHATSAPP_NUMBER=
CURRENCY=S/

# --- Acceso al panel ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET=
WEBHOOK_SECRET=

# --- evolution-go (WhatsApp) ---
EVOLUTION_DB_PASSWORD=
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE=kddesign
EVOLUTION_INSTANCE_TOKEN=

# --- IA (Google AI Studio, capa gratuita) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo en orden si el principal falla (cuota 429, 5xx, timeout)
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_TIMEOUT_SECONDS=40
# Confianza mínima (0-1) para dar por identificado el modelo de la foto
MATCH_THRESHOLD=0.6

# Carga el catálogo inicial (20 vestidos) la primera vez
SEED_CATALOG=true

# --- Puertos alternos en el host (sólo 127.0.0.1) ---
KD_HTTP_PORT=18480
KD_EVO_PORT=18481

# --- Agente conversacional (servicio agente) ---
# Sin tocar nada usa Gemini Flash-Lite GRATIS con GEMINI_API_KEY (Google AI Studio, capa gratuita).
# Para DeepSeek por OpenRouter (de pago) descomenta:
# LLM_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-chat-v3.1,deepseek/deepseek-v4-flash
# Modelo de embeddings local (fastembed). Alternativa ligera: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=Xenova/multilingual-e5-small
# Motor de conversación por defecto: actual | deepseek. Con deepseek el bot conversa con más soltura,
# cuenta datos de la tienda (agente/seed/tienda.md) y se niega a lo que no es del rubro.
# Usa DEEPSEEK_API_KEY o, si está vacía, OPENROUTER_API_KEY.
MOTOR=actual
OPENROUTER_API_KEY=
# DEEPSEEK_MODEL=deepseek/deepseek-chat-v3.1,deepseek/deepseek-v4-flash
KD_AGENT_PORT=18482
# Vacío desactiva el agente y el bot usa sólo Gemini
AGENT_URL=http://agente:8000

# --- Proceso comercial del agente ---
# Código del vestido del anuncio (demo de un solo producto). Vacío = el agente no asume ninguno.
KD_PRODUCTO_DEMO=
# 1 = mencionar el stock de sucursales (tabla warehouses). Baruka tiene un showroom con cita: 0.
KD_SUCURSALES=0

# --- Decisiones: SetFit (local) y Jev (TypeSafe) ---
# Clasificador: auto = e5 ajustado con SetFit si en el build gana al e5 sin ajustar; base | setfit lo fuerzan.
KD_CLASIFICADOR=auto
# Pasos del ajuste SetFit en el build (300 ≈ 7 min en un Mac, 2-3 veces más en el EC2). 0 = no entrenarlo.
KD_SETFIT_PASOS=300
# Jev por OpenRouter (usa OPENROUTER_API_KEY): off | sombra (solo registra) | cascada (decide cuando el local duda)
KD_JEV_MODO=off
# 1 = Jev revisa la respuesta del LLM y quita lo que afirme de la prenda sin estar en la ficha (~0,3 s más)
KD_JEV_VERIFICAR=0
# Solo si se llama directo a TypeSafe (JEV_URL=https://api.typesafe.ai/v1/systemone)
# JEV_API_KEY=

# --- Discernimiento (Capa de Juicio, backend/internal/juicio) ---
# off = no hace nada; sombra = registra [JUICIO] y la decisión, sin cambiar la respuesta;
# activo = además deriva a una persona y calla. Por defecto «sombra»: se mide antes de dejarle decidir.
JUICIO_MODO=sombra
# Seguimiento (recordatorio a conversaciones en silencio): se activa en Ajustes del panel
# (seguimiento_habilitado=true, seguimiento_horas=24). Apagado por defecto: escribe a clientas reales.
