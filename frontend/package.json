{
  "name": "kddesign-crm",
  "description": "Panel CRM de Baruka Design: vinculación de WhatsApp, kanban de pedidos, conversaciones y stock",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr"
    
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.1",
    "@builder.io/qwik-city": "1.20.1",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "undici": "^7.10.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
